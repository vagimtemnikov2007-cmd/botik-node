BOT_TOKEN=
PORT=8000
# Render provides its public URL automatically. Leave empty on Render.
# Outside Render: empty = polling, HTTPS public base URL = webhook.
WEBHOOK_URL=
# Required in webhook mode; 16-256 letters, digits, underscores or hyphens.
WEBHOOK_SECRET=
CONCURRENCY=2
MAX_QUEUE=30
USER_COOLDOWN_SECONDS=10
MAX_FILE_MB=49
MAX_DURATION_SECONDS=1800
JOB_TIMEOUT_SECONDS=300
DEFAULT_QUALITY=720
MAX_LINKS=3
MAX_ITEMS=10
# Optional: Netscape cookies text, configured as a multiline secret in Render.
COOKIES_TEXT=
# Optional comma-separated Telegram user IDs. Empty = public bot.
ALLOWED_USERS=
LOG_LEVEL=info
