BOT_TOKEN=
PORT=8000
# Empty = long polling. HTTPS public base URL = webhook mode.
WEBHOOK_URL=
# Required in webhook mode; 16-256 letters, digits, underscores or hyphens.
WEBHOOK_SECRET=
CONCURRENCY=2
MAX_QUEUE=30
USER_COOLDOWN_SECONDS=10
MAX_FILE_MB=49
MAX_DURATION_SECONDS=1800
JOB_TIMEOUT_SECONDS=300
DEFAULT_QUALITY=720
MAX_LINKS=3
MAX_ITEMS=10
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Netscape-format cookies; optional, never commit them.
COOKIES_FILE=
# Optional comma-separated Telegram user IDs. Empty = public bot.
ALLOWED_USERS=
LOG_LEVEL=info
